--- a/drivers/clk/clk-en7523.c
+++ b/drivers/clk/clk-en7523.c
@@ -33,6 +33,29 @@
 #define REG_RESET_CONTROL2		0x830
 #define   REG_RESET2_CONTROL_PCIE2	BIT(27)
 #define REG_RESET_CONTROL1		0x834
+
+/*
+ * The NP register block is shared between the reset controller (RST_CTRL1:
+ * GSW, PCIe, USB, ...) and the PCIe clock handling in this driver. A plain
+ * read-modify-write from two contexts can lose a bit update: in particular
+ * the PCIe path used to keep a stale RST_CTRL1 value across msleep() and
+ * write it back, re-asserting the switch reset while mt7530 was polling for
+ * it to come out of reset. Serialise every read-modify-write of these
+ * registers.
+ */
+static DEFINE_SPINLOCK(en7523_np_lock);
+
+static void en7523_np_update_bits(void __iomem *base, u32 reg, u32 mask, u32 set)
+{
+	unsigned long flags;
+	u32 val;
+
+	spin_lock_irqsave(&en7523_np_lock, flags);
+	val = readl(base + reg);
+	val = (val & ~mask) | (set & mask);
+	writel(val, base + reg);
+	spin_unlock_irqrestore(&en7523_np_lock, flags);
+}
 #define   REG_RESET_CONTROL_PCIEHB	BIT(29)
 #define   REG_RESET_CONTROL_PCIE1	BIT(27)
 #define   REG_RESET_CONTROL_PCIE2	BIT(26)
@@ -547,36 +570,34 @@
 {
 	struct en_clk_gate *cg = container_of(hw, struct en_clk_gate, hw);
 	void __iomem *np_base = cg->base;
-	u32 val, mask;
+	u32 mask;
 
 	/* Need to pull device low before reset */
-	val = readl(np_base + REG_PCI_CONTROL);
-	val &= ~(REG_PCI_CONTROL_PERSTOUT1 | REG_PCI_CONTROL_PERSTOUT);
-	writel(val, np_base + REG_PCI_CONTROL);
+	mask = REG_PCI_CONTROL_PERSTOUT1 | REG_PCI_CONTROL_PERSTOUT;
+	en7523_np_update_bits(np_base, REG_PCI_CONTROL, mask, 0);
 	usleep_range(1000, 2000);
 
 	/* Enable PCIe port 1 */
-	val |= REG_PCI_CONTROL_REFCLK_EN1;
-	writel(val, np_base + REG_PCI_CONTROL);
+	en7523_np_update_bits(np_base, REG_PCI_CONTROL,
+			      REG_PCI_CONTROL_REFCLK_EN1,
+			      REG_PCI_CONTROL_REFCLK_EN1);
 	usleep_range(1000, 2000);
 
 	/* Reset to default */
-	val = readl(np_base + REG_RESET_CONTROL1);
 	mask = REG_RESET_CONTROL_PCIE1 | REG_RESET_CONTROL_PCIE2 |
 	       REG_RESET_CONTROL_PCIEHB;
-	writel(val & ~mask, np_base + REG_RESET_CONTROL1);
+	en7523_np_update_bits(np_base, REG_RESET_CONTROL1, mask, 0);
 	usleep_range(1000, 2000);
-	writel(val | mask, np_base + REG_RESET_CONTROL1);
+	en7523_np_update_bits(np_base, REG_RESET_CONTROL1, mask, mask);
 	msleep(100);
-	writel(val & ~mask, np_base + REG_RESET_CONTROL1);
+	en7523_np_update_bits(np_base, REG_RESET_CONTROL1, mask, 0);
 	usleep_range(5000, 10000);
 
 	/* Release device */
 	mask = REG_PCI_CONTROL_PERSTOUT1 | REG_PCI_CONTROL_PERSTOUT;
-	val = readl(np_base + REG_PCI_CONTROL);
-	writel(val & ~mask, np_base + REG_PCI_CONTROL);
+	en7523_np_update_bits(np_base, REG_PCI_CONTROL, mask, 0);
 	usleep_range(1000, 2000);
-	writel(val | mask, np_base + REG_PCI_CONTROL);
+	en7523_np_update_bits(np_base, REG_PCI_CONTROL, mask, mask);
 	msleep(250);
 
 	return 0;
@@ -586,11 +607,8 @@
 {
 	struct en_clk_gate *cg = container_of(hw, struct en_clk_gate, hw);
 	void __iomem *np_base = cg->base;
-	u32 val;
-
-	val = readl(np_base + REG_PCI_CONTROL);
-	val &= ~REG_PCI_CONTROL_REFCLK_EN1;
-	writel(val, np_base + REG_PCI_CONTROL);
+	en7523_np_update_bits(np_base, REG_PCI_CONTROL,
+			      REG_PCI_CONTROL_REFCLK_EN1, 0);
 }
 
